<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns = "sap.m" xmlns:f="sap.ui.layout.form">
    <Dialog title = "Employee  Details">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout" emptySpanL="4" labelSpanL="2" emptySpanM="4" labelSpanM="2">
            <f:content>
                <Label text = "Name"></Label>
                <Input value="{name}"></Input>
                <Label text = "Designation"></Label>
                <Input value="{Designation}"></Input>
                <Label text = "Number"></Label>
                <Input value="{number}"></Input>
                <Label text = "Salary"></Label>
                <Input value="{Salary}"></Input>
                <Label text = "EMail"></Label>
                <Input value="{Email}"></Input>
                <Label text = "Status"></Label>
                <Input value="{Status}"></Input>


            </f:content>
            
        </f:SimpleForm>
        <beginButton>
        <Button text = "Save" icon = "sap-icon://add" type ="Emphasized" press="onSave"></Button>
        </beginButton>
        <endButton>
        <Button text = "Close" icon = "sap-icon://decline" type ="Reject" press="onClose"></Button>
        </endButton>
    </Dialog>
</core:FragmentDefinition>